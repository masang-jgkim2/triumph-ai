# triumph_ai 로컬 통합용 참고 값 (각 서비스 .env에 맞게 복사·수정)
# 실제 사용: config/local.env (gitignore) — start-all.ps1이 triumphserver에 주입

# --- API (Laravel) ---
API_BASE_URL=http://127.0.0.1:8000
APP_URL=http://127.0.0.1:8000

# --- WebSocket ---
WS_HTTP_URL=http://127.0.0.1:9603
WEBSOCKET_URL=http://127.0.0.1:9603

# triumphserver (Vite) — .env 또는 .env.proxy
VITE_API_SERVER_URL=http://127.0.0.1:8000
VITE_SOCKET_SERVER_URL=http://127.0.0.1:9603

# --- 공통 인프라 (팀 dev DB/Redis 주소로 교체) ---
# DATABASE_URL=mysql://user:pass@host:3306/dbname
# REDIS_URL=redis://127.0.0.1:6379
# DB_HOST=127.0.0.1
# REDIS_HOST=127.0.0.1
